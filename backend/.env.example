# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Postgres connection string used by the app's own SQLAlchemy engine.
# Supabase project settings -> Database -> Connection string -> URI (use the "Session pooler" or
# direct connection host). Must use the asyncpg driver scheme below.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# Supabase project settings -> API Keys.
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
# Secret key: server-side only, never exposed to the frontend. Used only for admin-level
# Supabase Auth operations (e.g. looking up a user by id). Optional for Phase 1-2.
SUPABASE_SECRET_KEY=CHANGE_ME

# Supabase project settings -> JWT Keys.
# Newer projects use asymmetric signing keys with no shared secret — leave SUPABASE_JWT_SECRET
# blank and the backend validates tokens against the JWKS endpoint below (derived from
# SUPABASE_URL automatically if SUPABASE_JWKS_URL is left blank too).
SUPABASE_JWKS_URL=
# Only set this if your project still uses the legacy shared HS256 secret (enables fast local
# verification with no network call). Leave blank otherwise.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:4200

LOG_LEVEL=INFO

# Backblaze B2 (S3-compatible), single private bucket for all template/draft media.
# Bucket details -> B2 Cloud Storage -> Buckets -> your bucket (endpoint + name).
# All six optional: if any is unset, media upload/retrieval is disabled (routes
# return 503 MEDIA_STORAGE_NOT_CONFIGURED) rather than failing to boot.
B2_ENDPOINT_URL=https://s3.CHANGE_ME.backblazeb2.com
B2_BUCKET_NAME=CHANGE_ME
B2_PRODUCER_KEY_ID=CHANGE_ME
B2_PRODUCER_KEY_SECRET=CHANGE_ME
B2_CONSUMER_KEY_ID=CHANGE_ME
B2_CONSUMER_KEY_SECRET=CHANGE_ME
# Only for scripts/configure_b2_cors.py (sets the bucket's CORS rules, which browser
# uploads need). Needs the writeBuckets capability — never used by the app itself.
# B2_ADMIN_KEY_ID=
# B2_ADMIN_KEY_SECRET=
